OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
# Optional: run subagents on a different (e.g. cheaper) model
SUBAGENT_MODEL=gpt-5.4-mini

# Langfuse tracing: leave the keys empty to run without tracing.
# Self-hosted (`make langfuse-up`): http://localhost:3000
# Cloud: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Corpus the agent researches (default: the platform-lab repo root)
# NOTES_ROOT=/path/to/notes
