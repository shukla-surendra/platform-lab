# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/

# uv
uv.lock.bak

# Jupyter
.ipynb_checkpoints/

# MLflow / Evidently run artifacts (regenerated on each run, not source)
mlruns/
mlflow.db
evidently_report.html
executed_output.ipynb

# Editor / OS
.DS_Store
.vscode/
.idea/

# Helm subchart dependency packages (helm dependency update/build output, e.g.
# charts/loki-stack-2.10.3.tgz) — regenerable from Chart.yaml/Chart.lock, not source.
# Was bare ".tgz", which only matches a file literally named ".tgz" and silently
# ignored nothing real — one stray package (grafana-log-viewer/charts/loki-stack-*.tgz)
# was already committed before this was caught, since being tracked bypasses gitignore
# entirely regardless of the pattern.
*.tgz

# Terraform — .tfstate/.tfstate.backup can embed live credentials (e.g. an AKS
# admin kubeconfig: client cert/key/admin password) plus real subscription/tenant
# IDs, and .terraform/ holds downloaded provider binaries (hundreds of MB, pure
# build output). None of this belongs in a public repo or git history at all.
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc