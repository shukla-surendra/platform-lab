{
  "uid": "rust-api",
  "title": "rust-api — health & requests",
  "description": "rust-api has no /metrics endpoint — it is a stateless test server, not an instrumented service. Everything here comes from two sources that need zero setup on this app's part: pod-level metrics (CPU, memory, restarts) from cAdvisor/kube-state-metrics, already scraped for every pod on the cluster; and request-level activity (rate, status codes) computed from tower_http's access-log lines via LogQL, not from Prometheus at all. Paired with the logs dashboard: that one is the raw stream, this one is the shape of it over time.",
  "tags": ["rust-api", "kubernetes", "loki"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(kube_pod_container_status_running{container=\"rust-api\"}, namespace)",
        "refresh": 1,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "allValue": ".+",
        "description": "Defaults to All. A hardcoded namespace here renders every panel empty on any install that used a different one."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Pod health (cAdvisor / kube-state-metrics)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Pods running",
      "description": "kube_pod_container_status_running for the rust-api container. Zero here means every other panel on this dashboard is measuring nothing.",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "count(kube_pod_container_status_running{namespace=~\"$namespace\", container=\"rust-api\"} == 1)",
          "legendFormat": "running",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#D64545", "value": null },
              { "color": "#3D9A50", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Restarts (1h)",
      "description": "Should be zero. A stateless app restarting under no load points at a crash (OOMKill, panic) rather than anything downstream.",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", container=\"rust-api\"}[1h]))",
          "legendFormat": "restarts",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#3D9A50", "value": null },
              { "color": "#D64545", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Cores consumed, per pod. requests.cpu is 20m in values.yaml — a handler this light staying near that line under load is expected, not a problem.",
      "gridPos": { "h": 7, "w": 7, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container=\"rust-api\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "axisLabel": "cores" }
        }
      }
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory (working set)",
      "description": "limits.memory is 128Mi in values.yaml. A pod climbing toward that line and getting OOMKilled shows up as a restart above before it shows up here — the two panels are meant to be read together.",
      "gridPos": { "h": 7, "w": 7, "x": 17, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\", container=\"rust-api\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "axisLabel": "bytes" }
        }
      }
    },

    {
      "type": "row",
      "title": "Request activity (derived from logs via LogQL, not Prometheus)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate",
      "description": "tower_http's TraceLayer logs one line per completed request, carrying a `status` field, at DEBUG. Needs RUST_LOG to include tower_http=debug — config.rustLog defaults to exactly that. Matched on the presence of the status field rather than the log message text, so this does not depend on tower-http's exact wording.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(rate({namespace=~\"$namespace\", app=\"rust-api\"} | json | fields_status=~\".+\" [1m]))",
          "legendFormat": "requests/sec",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3B82F6" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "axisLabel": "requests/sec" }
        }
      }
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Responses by status code",
      "description": "Grouped on the extracted `status` field. A rising 4xx/5xx share here is the first place to look before treating a request-rate drop as traffic loss.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (fields_status) (rate({namespace=~\"$namespace\", app=\"rust-api\"} | json | fields_status=~\".+\" [1m]))",
          "legendFormat": "{{fields_status}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "axisLabel": "requests/sec" }
        }
      }
    },

    {
      "id": 7,
      "type": "stat",
      "title": "5xx responses (1h)",
      "description": "Should be zero — every handler in this app is designed to return a deliberate status via /api/test/status/{code}, not to fail. Non-zero outside of someone testing that endpoint on purpose is worth a look at the log stream.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=~\"$namespace\", app=\"rust-api\"} | json | fields_status=~\"5..\" [1h]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#3D9A50", "value": null },
              { "color": "#D64545", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 8,
      "type": "stat",
      "title": "Heartbeats (1h)",
      "description": "One `alive` line every HEARTBEAT_SECS (default 30 — up to 120 expected per hour). Absence is the only thing that makes an empty request-rate panel above mean 'quiet' rather than 'broken' — see the logs dashboard for the same reasoning.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=~\"$namespace\", app=\"rust-api\"} |= \"alive\" [1h]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#D64545", "value": null },
              { "color": "#3D9A50", "value": 1 }
            ]
          }
        }
      }
    }
  ]
}
