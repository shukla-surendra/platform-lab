{
  "Comment": "Order workflow: validate -> (valid?) -> process, with retries and failure handling",
  "StartAt": "ValidateOrder",
  "States": {

    "ValidateOrder": {
      "Type": "Task",
      "Resource": "${validate_arn}",
      "ResultPath": "$.validation",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RecordFailure" }
      ],
      "Next": "IsValid"
    },

    "IsValid": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.validation.valid", "BooleanEquals": true, "Next": "ProcessOrder" }
      ],
      "Default": "OrderRejected"
    },

    "ProcessOrder": {
      "Type": "Task",
      "Resource": "${process_arn}",
      "ResultPath": "$.result",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["TransientError"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RecordFailure" }
      ],
      "Next": "OrderCompleted"
    },

    "OrderCompleted": {
      "Type": "Succeed"
    },

    "OrderRejected": {
      "Type": "Fail",
      "Error": "OrderRejected",
      "Cause": "Validation said the order is not valid"
    },

    "RecordFailure": {
      "Type": "Pass",
      "Comment": "Placeholder: in real life publish to SNS / write to DynamoDB here",
      "Next": "OrderFailed"
    },

    "OrderFailed": {
      "Type": "Fail",
      "Error": "OrderFailed",
      "Cause": "A step failed after retries; see the execution history"
    }
  }
}
