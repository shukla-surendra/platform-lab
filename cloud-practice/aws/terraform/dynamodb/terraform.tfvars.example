# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

region  = "us-east-1"
project = "aws-mastery-dynamodb"

hash_key  = "pk"
range_key = "sk"

billing_mode                  = "PAY_PER_REQUEST"
enable_point_in_time_recovery = true

enable_ttl          = true
ttl_attribute_name  = "expires_at"

enable_stream = false
