# LLM_PROVIDER=ollama (default) -- local, free, no API key needed
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:latest

# LLM_PROVIDER=openai -- real API, real cost, needs OPENAI_API_KEY set below
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-real-key
# OPENAI_MODEL=gpt-4o-mini

MODEL_TEMPERATURE=0.2
